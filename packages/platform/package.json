{
  "name": "@payops/platform",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "bin": {
    "payops-platform": "./dist/bin.js"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "pnpm run test:unit && pnpm run test:dist",
    "test:dist": "pnpm run build && node test/package-artifact.esm-smoke.mjs",
    "test:unit": "vitest run --maxWorkers=1",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@payops/contracts": "workspace:^0.1.1",
    "@payops/ingestion": "workspace:^0.1.1",
    "@payops/reconciliation": "workspace:^0.1.1",
    "@payops/webhooks": "workspace:^0.1.1",
    "@solana/kit": "8.5.0",
    "@solana/pay": "1.0.26",
    "decimal.js": "10.6.0",
    "drizzle-orm": "0.45.4",
    "postgres": "3.4.9",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "vitest": "5.0.4"
  }
}
